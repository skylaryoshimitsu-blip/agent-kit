{
  "defaultMode": "acceptEdits",
  "allow": [
    "Read", "Edit", "Write", "Glob", "Grep", "WebFetch", "WebSearch",
    "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
    "Bash(git add:*)", "Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git switch:*)",
    "Bash(git branch:*)", "Bash(git fetch:*)", "Bash(git pull:*)", "Bash(git push:*)",
    "Bash(git stash:*)", "Bash(git rev-parse:*)", "Bash(git ls-files:*)", "Bash(git clone:*)",
    "Bash(git -C:*)", "Bash(git -c:*)",
    "Bash(gh pr create:*)", "Bash(gh pr view:*)", "Bash(gh pr list:*)", "Bash(gh pr diff:*)",
    "Bash(gh pr comment:*)", "Bash(gh pr checks:*)",
    "Bash(npm:*)", "Bash(npx:*)", "Bash(pnpm:*)", "Bash(node:*)", "Bash(python3:*)", "Bash(pip:*)",
    "Bash(vercel:*)", "Bash(supabase:*)",
    "Bash(curl:*)", "Bash(jq:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(head:*)", "Bash(tail:*)",
    "Bash(grep:*)", "Bash(find:*)", "Bash(wc:*)", "Bash(mkdir:*)", "Bash(cp:*)", "Bash(mv:*)",
    "Bash(sed:*)", "Bash(sort:*)", "Bash(date:*)", "Bash(echo:*)", "Bash(cd:*)",
    "Bash(bash hooks/:*)", "Bash(bash .agent-kit/hooks/:*)", "Bash(bash ../agent-kit/:*)",
    "Bash(bash install.sh:*)",
    "mcp__Supabase__list_projects", "mcp__Supabase__get_project", "mcp__Supabase__list_tables",
    "mcp__Supabase__list_migrations", "mcp__Supabase__list_extensions", "mcp__Supabase__get_advisors",
    "mcp__Supabase__query_logs", "mcp__Supabase__get_project_url", "mcp__Supabase__get_publishable_keys",
    "mcp__Supabase__search_docs", "mcp__Supabase__generate_typescript_types",
    "mcp__Supabase__execute_sql", "mcp__Supabase__apply_migration",
    "mcp__Supabase__list_edge_functions", "mcp__Supabase__get_edge_function", "mcp__Supabase__deploy_edge_function"
  ],
  "deny": [
    "Bash(gh pr merge:*)",
    "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git push --force-with-lease:*)",
    "Bash(git push origin main:*)", "Bash(git push origin HEAD:main:*)", "Bash(git push origin master:*)",
    "Bash(git push -u origin main:*)",
    "Bash(vercel --prod:*)", "Bash(vercel deploy --prod:*)",
    "Bash(rm -rf /:*)", "Bash(rm -rf ~:*)",
    "mcp__Supabase__delete_branch", "mcp__Supabase__pause_project", "mcp__Supabase__merge_branch",
    "mcp__github__merge_pull_request"
  ]
}
